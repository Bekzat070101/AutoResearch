#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")"
export PYTHONUNBUFFERED=1
export QIYAN_DB="${QIYAN_DB:-/tmp/qiyan.db}"
python3 -V
python3 - <<'PY'
import pathlib
import shutil
import sys
import zipfile

print("py", sys.version, flush=True)
root = pathlib.Path("/tmp/pydeps")
root.mkdir(parents=True, exist_ok=True)
marker = root / ".ok"
tag = f"cp{sys.version_info.major}{sys.version_info.minor}"
wheels = sorted(pathlib.Path("vendor_wheels").glob("*.whl"))
want = "\n".join(w.name for w in wheels)
if not marker.exists() or marker.read_text() != want:
    n = 0
    if not wheels:
        raise SystemExit("no vendor_wheels")
    for child in root.iterdir():
        if child.name == ".ok":
            continue
        if child.is_dir():
            shutil.rmtree(child)
        else:
            child.unlink()
    for w in wheels:
        name = w.name
        if (
            "py3-none-any" in name
            or "py2.py3-none-any" in name
            or tag in name
        ):
            zipfile.ZipFile(w).extractall(root)
            n += 1
    print("wheels", n, "tag", tag, flush=True)
    if n == 0:
        raise SystemExit(f"no wheels for {tag}")
    marker.write_text(want)
sys.path.insert(0, str(root))
import fastapi
import pydantic
import uvicorn

print("deps ok", fastapi.__version__, pydantic.__version__, flush=True)
PY
export PYTHONPATH="/tmp/pydeps:${PWD}/server:${PYTHONPATH:-}"
exec python3 -m uvicorn server.main:app --host 0.0.0.0 --port 9000 --log-level info
