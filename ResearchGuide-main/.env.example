# 复制为 .env 后填入密钥。不要把填好的 .env 发给别人或提交到公开仓库。
# OpenAI 兼容接口。DeepSeek 示例：deepseek-flash 最省（启研对它默认关掉思考模式）；要更强可换 deepseek-v4-pro。旧名 deepseek-chat 已列入停用。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash

# 可选：推理强度 low / high / max。只有支持的模型才填，不填就用模型默认值。
# LLM_REASONING_EFFORT=low

# 可选：管理员口令。设了之后，页面「连接模型」要带这个口令才能改服务器的密钥和地址；不设则只有服务器本机能改。
# ADMIN_TOKEN=

# 若使用其他兼容服务，改 BASE_URL / MODEL 即可，例如：
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# ---------- 账号与数据（见 docs/DEPLOY.md「账号与数据」） ----------
# 库文件放在会保留的盘上。云函数的 /tmp 会随实例回收清空，账号和记录会一起丢。
# QIYAN_DB=/mnt/nas/qiyan.db
# 已注册账号的加密副本（用户名+密码哈希，不含明文）。不要和 QIYAN_DB 放在同一块 /tmp 上。
# 设了之后，发版换空库仍能用原来的用户名密码登录。对话和个人 key 仍在主库里。
# QIYAN_ACCOUNT_STORE=/mnt/nas/qiyan-accounts.json.enc
# 封装个人密钥。B8 迁移完成前不要在已有生产库上新设或改这个值。
# QIYAN_SECRET=
# 论文正文缓存在 SQLite paper_text。/tmp 期间配额 100MB。函数 /code 只读时磁盘旁路设到 /tmp。
# ARXIV_CACHE_DIR=/tmp/papers
# ARXIV_CACHE_MAX_BYTES=104857600
# ARXIV_CACHE_MAX_FILES=2000
# 备份加密。张效端和邬程灿离线保管。OSS 生命周期改 >7 天必须同步改隐私说明。
# BACKUP_KEY=
# BACKUP_DIR=/tmp/qiyan-backup
# BACKUP_OSS_BUCKET=
# BACKUP_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# 恢复时业务接口 503，/api/admin/* 和 /api/health 仍可用。
# QIYAN_MAINTENANCE=1

# 微信登录：个人订阅号的「服务器配置」（见 docs/DEPLOY.md「账号与数据」）。不配就只能访客进入。
# WECHAT_TOKEN=            # 和公众号后台「服务器配置」里填的 Token 一样，随便一串长随机字符
# WECHAT_AES_KEY=          # 后台「随机生成」的 EncodingAESKey（43 位）。线上必须设：没有它消息体不签名，能被伪造
# WECHAT_APP_ID=           # 公众号的 AppID（开发者 ID），解密时核对
# WECHAT_ALLOW_PLAINTEXT=1 # 只给本机调试：允许明文模式（消息体没签名、能被伪造）。线上不要设
# WECHAT_ACCOUNT_ID=       # 公众号原始 ID（gh_ 开头），用来显示关注二维码；或者直接给图片地址 WECHAT_QR_URL
# WECHAT_QR_URL=
# WECHAT_ACCOUNT_NAME=启研
# 模型调用额度（每天，北京时间）：全站合计、绑了微信的人、访客。超了就当模型没开，功能回退到规则版。
# 一次调用约几分钱（DeepSeek flash，几千 token）；全站上限就是每天花费的上限。
# LLM_DAILY_TOTAL=2000
# LLM_DAILY_USER=150
# LLM_DAILY_GUEST=15
# 全体访客加起来一天最多几次（默认 500）：访客号谁都能开，刷号最多花掉这一份
# LLM_DAILY_GUESTS=500
# 同一个公网出口一小时最多开几次微信登录、几个访客号（默认 600；机房、宿舍几百人共用一个出口）
# AUTH_PER_IP_HOUR=600
# 要等模型的活（对话、交任务、方向推荐……）专用线程数（默认 96）和排队上限（默认 160，再多回 503）
# QIYAN_MODEL_THREADS=96
# QIYAN_MODEL_QUEUE=160
# 普通接口的工作线程数（默认 128）。等模型的活不占这里
# QIYAN_THREADS=128
# 在反向代理后面时设 1，按 X-Forwarded-For 限频
# TRUST_PROXY=1
# 只在本机开发用：没配公众号时，登录页多一个「模拟微信发送」按钮。配了 WECHAT_TOKEN 就不生效。线上不要设。
# AUTH_DEV_CODES=1
